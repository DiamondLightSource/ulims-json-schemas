{
    "title": "data_catalogue/p99/grid_scan",
    "$id": "/data_catalogue/p99/grid_scan/1.0.1",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "scan_parameters": {
            "title": "Scan Parameters",
            "type": "object",
            "properties": {
                "scan_command": {
                    "title": "Plan Name",
                    "description": "The specific Bluesky scan plan executed",
                    "type": "string",
                    "nexus_path": ["/entry/plan_metadata/plan_name"],
                    "highlight": true
                },
                "scan_type": {
                    "title": "Scan Type",
                    "type": "string",
                    "nexus_path": ["/entry/plan_metadata/plan_type"]
                },
                "start_time": {
                    "title": "Scan Start Time",
                    "type": "string",
                    "format": "date-time",
                    "maxLength": 128,
                    "nexus_path": ["/entry/diamond_scan/start_time"]
                },
                "end_time": {
                    "title": "Scan End Time",
                    "type": "string",
                    "format": "date-time",
                    "maxLength": 128,
                    "nexus_path": ["/entry/diamond_scan/end_time"]
                },
                "duration_s": {
                    "title": "Scan Duration",
                    "description": "Total duration of the scan in seconds",
                    "type": "number",
                    "minimum": 0.0,
                    "nexus_path": ["/entry/diamond_scan/duration"]
                }
            }
        },
        "optical_configurations": {
            "title": "Optical Configurations",
            "type": "object",
            "properties": {
                "energy": {
                    "title": "Beam Energy",
                    "type": "number",
                    "minimum": 0.0,
                    "nexus_path": ["/entry/plan_metadata/energy/value"]
                },
                "detector_distance": {
                    "title": "Detector Distance",
                    "type": "number",
                    "minimum": 0.0,
                    "nexus_path": ["/entry/plan_metadata/detector_dist/value"]
                }
            }
        },
        "detector_information": {
            "$ref": "/data_catalogue/p99/_detectors/1.0.0.json",
            "title": "Detector Information"
        },
        "motor_information": {
            "title": "Motor Settings",
            "type": "object",
            "properties": {
                "sample_stage_x_velocity": {
                    "title": "Stage X Velocity",
                    "type": "number",
                    "minimum": 0.0,
                    "nexus_path": ["/entry/instrument/sample_stage-x/velocity"]
                },
                "sample_stage_y_velocity": {
                    "title": "Stage Y Velocity",
                    "type": "number",
                    "minimum": 0.0,
                    "nexus_path": ["/entry/instrument/sample_stage-y/velocity"]
                },
                "sample_stage_x_values": {
                    "title": "Sample Stage X Array",
                    "description": "The measured motor X position array across the scan points",
                    "type": "array",
                    "items": {
                        "type": "number",
                        "minimum": -1000.0,
                        "maximum": 1000.0
                    },
                    "nexus_path": ["/entry/andor2_det/sample_stage-x"]
                },
                "sample_stage_y_values": {
                    "title": "Sample Stage Y Array",
                    "description": "The measured motor Y position array across the scan points",
                    "type": "array",
                    "items": {
                        "type": "number",
                        "minimum": -1000.0,
                        "maximum": 1000.0
                    },
                    "nexus_path": ["/entry/andor2_det/sample_stage-y"]
                }
            }
        }
    }
}