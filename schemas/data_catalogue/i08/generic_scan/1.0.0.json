{
  "title": "data_catalogue/i08/generic_scan",
  "description": "Generic scan on I08",
  "$id": "/data_catalogue/i08/generic_scan/1.0.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scan_parameters": {
      "title": "Scan Parameters",
      "type": "object",
      "properties": {
        "start_time": {
          "title": "Scan Start Time",
          "description": "The time the scan started",
          "type": "string",
          "nexus_path": [
            "/entry/start_time"
          ]
        },
        "end_time": {
          "title": "Scan End Time",
          "description": "The time the scan ended",
          "type": "string",
          "nexus_path": [
            "/entry/end_time"
          ]
        },
        "scan_request": {
          "title": "Scan Request",
          "description": "Scan request information",
          "type": "string",
          "nexus_path": [
            "/entry/diamond_scan/scan_request",
            "/entry1/diamond_scan/scan_request"
          ]
        },
        "photon_energy": {
          "title": "Photon Energy",
          "type": "number",
          "nexus_path": [
            "/entry/instrument/PlaneGratingMonochromator/pgm_energy"
          ]
        }
      }
    },
    "sample_information": {
      "title": "Sample",
      "type": "object",
      "properties": {
        "name": {
          "title": "Sample Name",
          "type": "string",
          "nexus_path": [
            "/entry/sample/name",
            "/entry1/sample/name"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "sample_information": {
        "name": "dolor"
      },
      "scan_parameters": {
        "end_time": "dolor",
        "scan_request": "dolor",
        "photon_energy": -70000000,
        "start_time": "dolor"
      }
    }
  ]
}