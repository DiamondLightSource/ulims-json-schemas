{
    "title": "data_catalogue/i14/mapping_scan",
    "$id": "/data_catalogue/i14/mapping_scan/2.0.0",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Mapping scan on I14",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "scan_common": {
            "$ref": "/data_catalogue/shared/imaging/scan_common/1.0.0.json"
        },
        "scan_parameters": {
            "title": "Scan Parameters",
            "type": "object",
            "properties": {
                "photon_energy": {
                    "title": "Photon Energy",
                    "type": "number",
                    "nexus_path": ["/entry/instrument/DCM/dcm_energy", "/entry1/instrument/DCM/dcm_energy"]
                },
                "rotation": {
                    "title": "Sample Rotation",
                    "type": "number",
                    "nexus_path": ["/entry/instrument/sample/sample_rot", "/entry1/instrument/sample/sample_rot"]
                }
            }
        },
        "optical_configurations": {
            "title": "Optical Configurations",
            "type": "object",
            "properties": {
                "slit_size_x": {
                    "title": "Slit Size X",
                    "type": "number",
                    "nexus_path": ["/entry/instrument/S3/s3_x_size", "/entry1/instrument/S3/s3_x_size"]
                },
                "slit_size_y": {
                    "title": "Slit Size Y",
                    "type": "number",
                    "nexus_path": ["/entry/instrument/S3/s3_y_size", "/entry1/instrument/S3/s3_y_size"]
                }
            }
        },
        "sample_common": {
            "$ref": "/data_catalogue/shared/imaging/sample_common/1.0.0.json"
        }
    }
}