{
    "title": "data_catalogue/i07/diamond_scan",
    "$id": "/data_catalogue/i07/diamond_scan/1.0.0",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "detector_information": {
            "$ref": "/data_catalogue/i07/_detectors/1.0.0.json",
            "title": "Detector Information"
        },
        "instrument": {
            "title": "Instrument",
            "type": "object",
            "properties": {
                "name": {
                    "title": "Name",
                    "type": "string",
                    "nexus_path":  ["/entry/instrument/name"]
                },
                "ring_current": {
                    "title": "Ring Current",
                    "type": "number",
                    "nexus_path":  ["/entry/instrument/ringcurrent/ringcurrent"]
                },
                "beam_energy": {
                    "title": "Beam Energy",
                    "type": "number",
                    "nexus_path":  ["/entry/instrument/beamenergy/beamenergy"]
                }
            }
        },
        "scan_parameters": {
            "title": "Scan Parameters",
            "type": "object",
            "properties": {
                "start_time": {
                    "title": "Start Time",
                    "description": "The time the scan started",
                    "type": "string",
                    "nexus_path": ["/entry/start_time"]
                },
                "end_time": {
                    "title": "End Time",
                    "description": "The time the scan ended",
                    "type": "string",
                    "nexus_path": ["/entry/end_time"]
                },
                "scan_command": {
                    "title": "Scan command",
                    "description": "The scan command",
                    "type": "string",
                    "nexus_path": ["/entry/diamond_scan/scan_command"]
                },
                "scan_shape": {
                    "title": "Scan shape",
                    "description": "The scan shape",
                    "type": "number",
                    "nexus_path": ["/entry/diamond_scan/scan_shape"]
                }
            }
        },
        "comments": {
            "title": "Comments",
            "description": "Any further comments",
            "type": "string"
        }
    }
}