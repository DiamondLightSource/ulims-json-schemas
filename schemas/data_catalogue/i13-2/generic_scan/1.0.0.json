{
  "title": "data_catalogue/i13-2/generic_scan",
  "description": "Generic scan on I13-2",
  "$id": "/data_catalogue/i13-2/generic_scan/1.0.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scan_common": {
      "title": "data_catalogue/_shared/imaging/scan_common",
      "description": "Schema containing fields common to several imaging beamlines",
      "$id": "/data_catalogue/_shared/imaging/scan_common/2.0.0",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_time": {
          "title": "Scan Start Time",
          "description": "The time the scan started",
          "type": "string",
          "format": "date-time",
          "maxLength": 128,
          "nexus_path": [
            "/entry/start_time",
            "/entry1/start_time"
          ]
        },
        "end_time": {
          "title": "Scan End Time",
          "description": "The time the scan ended",
          "type": "string",
          "format": "date-time",
          "maxLength": 128,
          "nexus_path": [
            "/entry/end_time",
            "/entry1/end_time"
          ]
        },
        "scan_request": {
          "title": "Scan Request",
          "description": "Scan request information",
          "type": "string",
          "nexus_path": [
            "/entry/diamond_scan/scan_request",
            "/entry1/diamond_scan/scan_request"
          ]
        },
        "scan_number": {
          "title": "Scan Number",
          "type": "number",
          "nexus_path": [
            "/entry/diamond_scan/entry_identifier",
            "/entry1/diamond_scan/entry_identifier",
            "/entry1/entry_identifier"
          ]
        },
        "synchrotron_current": {
          "title": "Synchrotron Current",
          "type": "number",
          "nexus_path": [
            "/entry/instrument/source/current",
            "/entry1/instrument/source/current"
          ]
        }
      },
      "examples": [
        {
          "end_time": "2021-01-01T00:00:00.0Z",
          "scan_request": "dolor",
          "scan_number": -70000000,
          "synchrotron_current": -70000000,
          "start_time": "2021-01-01T00:00:00.0Z"
        }
      ]
    },
    "scan_parameters": {
      "title": "Scan Parameters",
      "type": "object",
      "properties": {
        "scan_command": {
          "title": "Scan Command",
          "type": "string",
          "nexus_path": [
            "/entry1/scan_command"
          ]
        },
        "scan_title": {
          "title": "Scan Title",
          "type": "string",
          "nexus_path": [
            "/entry1/title"
          ]
        },
        "turret_name": {
          "title": "Turret Name",
          "type": "string",
          "nexus_path": [
            "/entry1/before_scan/det_cfg/turret_name"
          ]
        },
        "translate_x": {
          "title": "Translate X",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/translate_x/translate_x"
          ]
        },
        "hex_y": {
          "title": "Sample Stage Height",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/hex/hex_y"
          ]
        },
        "cs1_z": {
          "title": "Sample Distance",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/cs1/cs1_z"
          ]
        },
        "filter1": {
          "title": "Filter 1",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/filter1/filter1"
          ]
        },
        "filter2": {
          "title": "Filter 2",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/filter2/filter2"
          ]
        },
        "filter3": {
          "title": "Filter 3",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/filter3/filter3"
          ]
        },
        "filter4": {
          "title": "Filter 4",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/filter4/filter4"
          ]
        },
        "filter5": {
          "title": "Filter 5",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/filter5/filter5"
          ]
        },
        "id_gap": {
          "title": "ID Gap",
          "type": "number",
          "nexus_path": [
            "/entry1/before_scan/id_gap/id_gap"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "scan_parameters": {
        "filter1": -70000000,
        "turret_name": "dolor",
        "translate_x": -70000000,
        "hex_y": -70000000,
        "cs1_z": -70000000,
        "scan_command": "dolor",
        "filter2": -70000000,
        "filter3": -70000000,
        "filter4": -70000000,
        "filter5": -70000000,
        "id_gap": -70000000,
        "scan_title": "dolor"
      },
      "scan_common": {
        "end_time": "2021-01-01T00:00:00.0Z",
        "scan_request": "dolor",
        "scan_number": -70000000,
        "synchrotron_current": -70000000,
        "start_time": "2021-01-01T00:00:00.0Z"
      }
    }
  ]
}