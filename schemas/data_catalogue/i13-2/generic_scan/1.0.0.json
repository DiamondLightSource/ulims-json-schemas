{
  "title": "data_catalogue/i13-2/generic_scan",
  "description": "Generic scan on I13-2",
  "$id": "/data_catalogue/i13-2/generic_scan/1.0.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scan_common": {
      "title": "data_catalogue/shared/imaging/scan_common",
      "description": "Schema containing fields common to several imaging beamlines",
      "$id": "/data_catalogue/shared/imaging/scan_common/1.0.0",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_time": {
          "title": "Scan Start Time",
          "description": "The time the scan started",
          "type": "string",
          "format": "date-time",
          "maxLength": 128,
          "nexus_path": [
            "/entry/start_time",
            "/entry1/start_time"
          ]
        },
        "end_time": {
          "title": "Scan End Time",
          "description": "The time the scan ended",
          "type": "string",
          "format": "date-time",
          "maxLength": 128,
          "nexus_path": [
            "/entry/end_time",
            "/entry1/end_time"
          ]
        },
        "scan_request": {
          "title": "Scan Request",
          "description": "Scan request information",
          "type": "string",
          "nexus_path": [
            "/entry/diamond_scan/scan_request",
            "/entry1/diamond_scan/scan_request"
          ]
        },
        "scan_number": {
          "title": "Scan Number",
          "type": "number",
          "nexus_path": [
            "/entry/diamond_scan/entry_identifier",
            "/entry1/diamond_scan/entry_identifier",
            "/entry1/entry_identifier"
          ]
        }
      },
      "examples": [
        {
          "end_time": "2021-01-01T00:00:00.0Z",
          "scan_request": "dolor",
          "scan_number": -70000000,
          "start_time": "2021-01-01T00:00:00.0Z"
        }
      ]
    },
    "scan_parameters": {
      "title": "Scan Parameters",
      "type": "object",
      "properties": {
        "scan_command": {
          "title": "Scan Command",
          "type": "string",
          "nexus_path": [
            "/entry1/scan_command"
          ]
        },
        "scan_title": {
          "title": "Scan Title",
          "type": "string",
          "nexus_path": [
            "/entry1/title"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "scan_parameters": {
        "scan_title": "dolor",
        "scan_command": "dolor"
      },
      "scan_common": {
        "end_time": "2021-01-01T00:00:00.0Z",
        "scan_request": "dolor",
        "scan_number": -70000000,
        "start_time": "2021-01-01T00:00:00.0Z"
      }
    }
  ]
}