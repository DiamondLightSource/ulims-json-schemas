{
  "title": "samples/b21/batch/buffer",
  "$id": "/samples/b21/batch/buffer/0.1.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume"
  ],
  "properties": {
    "volume": {
      "title": "Volume (mL)",
      "description": "Volume of buffer in mL",
      "type": "number",
      "minimum": 0.02,
      "maximum": 1.5
    },
    "notes": {
      "title": "Notes",
      "description": "Any further notes about the buffer",
      "type": "string"
    }
  },
  "examples": [
    {
      "volume": 0.242,
      "notes": "dolor"
    }
  ]
}