{
    "$id": "/samples/b21/batch_experiment/0.1.0",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "samples/b21/batch/experiment",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "volume"
    ],
    "properties": {
        "volume": {
            "title": "Volume (μL)",
            "description": "Volume of sample in μL",
            "type": "number",
            "minimum": 20.0,
            "maximum": 100.0
        },
        "notes": {
            "title": "Notes",
            "description": "Any further notes about the sample",
            "type": "string"
        }
    }
}